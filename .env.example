# Example environment variables for Gym Assistant System
# Copy this file to `.env` and fill with real values locally.

# Django
DJANGO_SECRET_KEY=replace_with_a_strong_secret_key
# DEBUG is off unless you set it. Use true for local development only.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# AI service keys (do NOT commit real keys)
# Provide at least one GEMINI or OPENROUTER key depending on provider
GEMINI_KEY_1=
#GEMINI_KEY_2=
#GEMINI_KEY_3=

OPENROUTER_KEY_1=
#OPENROUTER_KEY_2=

# Optional provider/model overrides
#GENAI_MODEL=models/gemini-2.0-flash
#OPENROUTER_MODEL=openrouter/auto

# AI/chat settings
GENAI_MAX_CHAT_HISTORY=4

# Database (optional) - default uses sqlite. Set POSTGRES_DB to use PostgreSQL.
#POSTGRES_DB=gym
#POSTGRES_USER=gym
#POSTGRES_PASSWORD=
#POSTGRES_HOST=localhost

# Other secrets
#SENTRY_DSN=

# Production (DEBUG off): HTTPS settings are enabled by default (secure cookies,
# SSL redirect). Set DJANGO_HTTPS=false only for plain-HTTP local runs.
# DJANGO_HTTPS=true
# DJANGO_HSTS_SECONDS=0   # raise (e.g. 31536000) once HTTPS works everywhere
# DJANGO_BEHIND_PROXY=true
